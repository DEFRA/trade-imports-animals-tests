{
  "name": "trade-imports-animals-tests",
  "version": "0.0.0",
  "type": "module",
  "description": "",
  "engines": {
    "node": ">=24"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "scripts": {
    "database:reseed": "./bin/database-reseed.sh",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write '**/*.{ts,js,mjs,md,json,yml,yaml}'",
    "format:check": "prettier --check '**/*.{ts,js,mjs,md,json,yml,yaml}'",
    "_clean": "rm -rf test-results playwright-report allure-results allure-report FAILED",
    "_clean_and_test": "npm run _clean && playwright test",
    "_test_docker_compose": "playwright test --config=playwright.docker-compose.config.ts",
    "_reset_and_clean_and_test_docker_compose": "npm run database:reseed && npm run _clean && npm run _test_docker_compose --",
    "_test_integration": "playwright test --config=playwright.integration.config.ts",
    "_reset_and_clean_and_test_integration": "npm run database:reseed && npm run _clean && npm run _test_integration --",
    "_test_e2e": "TRADE_IMPORTS_ANIMALS_FRONTEND_BASE_URL=\"${REWORKED_FRONTEND_URL:-http://localhost:3100}\" TRADE_IMPORTS_ANIMALS_ADMIN_BASE_URL=\"${ADMIN_FRONTEND_URL:-http://localhost:3001}\" playwright test --config=playwright.e2e.config.ts --project=e2e-live-animals --project=e2e-plant-products --project=admin",
    "_assert_stack": "sh ./bin/assert-stack.sh",
    "test": "npm run _assert_stack && npm run _clean && npm run database:reseed && npm run _test_e2e",
    "test:cdp": "npm run _clean_and_test -- --grep-invert '@agent|@compose|@a11y|@integration|@cross-browser'",
    "test:integration": "npm run _reset_and_clean_and_test_integration -- --grep '@integration'",
    "test:local": "npm run test:integration",
    "test:live-animals": "npm run _reset_and_clean_and_test_integration -- --project=frontend-live-animals-chromium",
    "test:plant-products": "npm run _reset_and_clean_and_test_integration -- --project=frontend-plant-products-chromium",
    "test:cross-browser": "npm run _clean && playwright test --config=playwright.cross-browser.config.ts",
    "test:a11y": "npm run _clean_and_test -- --grep '@a11y'",
    "test:browserstack": "echo 'BrowserStack Playwright tests not implemented yet'",
    "test:docker-compose": "npm run _reset_and_clean_and_test_docker_compose -- --grep-invert '@agent|@a11y'",
    "test:docker-compose:a11y": "npm run _reset_and_clean_and_test_docker_compose -- --grep '@a11y'",
    "test:docker-compose:ci": "npm run _test_docker_compose -- --grep-invert '@agent|@a11y' --reporter=blob,list,allure-playwright",
    "test:visual:update:macos": "npm run _clean && npm run database:reseed && npm run _test_e2e -- --grep '@visual' --update-snapshots",
    "test:visual:update:linux": "./bin/update-visual-baselines-linux.sh",
    "report": "allure generate allure-results --single-file --clean",
    "report:publish": "npm run report; ./bin/publish-tests.sh"
  },
  "devDependencies": {
    "@aws-sdk/client-sqs": "3.1090.0",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/cli": "0.1.14",
    "@playwright/test": "1.61.1",
    "@types/node": "26.0.1",
    "allure-commandline": "2.43.0",
    "allure-playwright": "3.10.1",
    "dotenv": "17.4.2",
    "eslint": "10.5.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "mongodb": "7.4.0",
    "prettier": "3.8.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint",
      "prettier --list-different"
    ],
    "*.{js,mjs,json,md,yml,yaml}": [
      "prettier --list-different"
    ]
  }
}
