{
  "name": "trade-imports-animals-tests",
  "version": "0.0.0",
  "type": "module",
  "description": "",
  "engines": {
    "node": ">=24"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "scripts": {
    "database:reseed": "./bin/database-reseed.sh",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write '**/*.{ts,js,mjs,md,json,yml,yaml}'",
    "format:check": "prettier --check '**/*.{ts,js,mjs,md,json,yml,yaml}'",
    "_clean": "rm -rf test-results playwright-report allure-results allure-report FAILED",
    "_clean_and_test": "npm run _clean && playwright test",
    "_test_docker_compose": "playwright test --config=playwright.docker-compose.config.ts",
    "_reset_and_clean_and_test_docker_compose": "npm run database:reseed && npm run _clean && npm run _test_docker_compose --",
    "test": "npm run _clean_and_test -- --grep-invert '@agent|@compose|@a11y'",
    "test:a11y": "npm run _clean_and_test -- --grep '@a11y'",
    "test:browserstack": "echo 'BrowserStack Playwright tests not implemented yet'",
    "test:docker-compose": "npm run _reset_and_clean_and_test_docker_compose -- --grep-invert '@agent|@a11y'",
    "test:docker-compose:a11y": "npm run _reset_and_clean_and_test_docker_compose -- --grep '@a11y'",
    "test:docker-compose:ci": "npm run _test_docker_compose -- --grep-invert '@agent|@a11y' --reporter=blob,list,allure-playwright",
    "test:visual:linux": "echo 'Linux visual baseline generation not yet implemented'",
    "report": "allure generate allure-results --single-file --clean",
    "report:publish": "npm run report; ./bin/publish-tests.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "^9.39.4",
    "@playwright/cli": "0.1.14",
    "@playwright/test": "1.60.0",
    "@types/node": "25.4.0",
    "allure-commandline": "2.37.0",
    "allure-playwright": "3.6.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.4",
    "husky": "9.1.7",
    "lint-staged": "^16.3.3",
    "mongodb": "7.1.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint",
      "prettier --list-different"
    ],
    "*.{js,mjs,json,md,yml,yaml}": [
      "prettier --list-different"
    ]
  }
}
