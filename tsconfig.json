{
  "compilerOptions": {
    "target": "ESNext",
    "module": "esnext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@adapters/*": ["adapters/*"],
      "@config/*": ["config/*"],
      "@domain/*": ["domain/*"],
      "@page-objects": ["ui/page-objects"],
      "@page-objects/*": ["ui/page-objects/*"],
      "@flows/*": ["ui/flows/*"],
      "@fixtures": ["fixtures"],
      "@fixtures/*": ["fixtures/*"],
      "@utils/*": ["utils/*"]
    }
  }
}
