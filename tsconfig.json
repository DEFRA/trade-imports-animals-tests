{
  "compilerOptions": {
    "strict": false,
    "target": "ESNext",
    "module": "esnext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@adapters/*": ["adapters/*"],
      "@config/*": ["config/*"],
      "@domain/*": ["domain/*"],
      "@page-objects": ["page-objects"],
      "@page-objects/*": ["page-objects/*"],
      "@flows/*": ["flows/*"],
      "@fixtures": ["fixtures"],
      "@fixtures/*": ["fixtures/*"],
      "@resources/*": ["resources/*"],
      "@utils/*": ["utils/*"],
      "@main-adapters/*": ["main-suite/adapters/*"],
      "@main-config/*": ["main-suite/config/*"],
      "@main-domain/*": ["main-suite/domain/*"],
      "@main-page-objects": ["main-suite/page-objects"],
      "@main-page-objects/*": ["main-suite/page-objects/*"],
      "@main-flows/*": ["main-suite/flows/*"],
      "@main-fixtures": ["main-suite/fixtures"],
      "@main-fixtures/*": ["main-suite/fixtures/*"],
      "@main-resources/*": ["main-suite/resources/*"],
      "@main-utils/*": ["main-suite/utils/*"]
    }
  }
}
